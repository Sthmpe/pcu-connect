# Copy to .env and fill in. Never commit the real .env file.
# These are the PUBLIC anon key + URL only - safe for a client app because
# Postgres Row Level Security enforces access, not this key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put SUPABASE_SERVICE_ROLE_KEY here or anywhere in lib/.
# The service role key belongs ONLY in Supabase Edge Function secrets
# (set via `supabase secrets set`), never in the Flutter app or git.
