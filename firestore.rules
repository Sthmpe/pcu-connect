rules_version = '2';

// PCU Connect security rules (docs/BACKEND_PLAN.md).
//
// Every request needs a verified Google sign-in whose email has an active
// users/{email} document. Emails are trimmed and lowercased before every
// lookup or comparison. users and meta are written only by Apps Script
// (service account, which bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.trim().lower();
    }

    function userPath(email) {
      return /databases/$(database)/documents/users/$(email);
    }

    function isMember() {
      return signedIn()
        && exists(userPath(myEmail()))
        && get(userPath(myEmail())).data.active == true;
    }

    function role() {
      return get(userPath(myEmail())).data.role;
    }

    function isAdmin() {
      return isMember() && role() == 'admin';
    }

    function isWorker() {
      return isMember() && role() == 'worker';
    }

    function guestPath(guestId) {
      return /databases/$(database)/documents/guests/$(guestId);
    }

    // Fields Firebase owns on a guest. Everything else (name, phone,
    // serviceDate, month, assignedTo, assignedName, assignedDate, sheetRow)
    // belongs to the sheet and is only ever written by Apps Script.
    function workFields() {
      return ['callStatus', 'membershipStatus', 'followUpCount', 'firstCallAt',
        'lastFeedback', 'lastFeedbackDate', 'teamJoined', 'memberSince',
        'sundayDates', 'wednesdayDates', 'updatedAt'];
    }

    function canSeeGuest(data) {
      return isAdmin() || (isWorker() && data.assignedTo == myEmail());
    }

    // Points for one follow-up: base 5 or 10, plus 10 per attendance (up to
    // 2), 20 for a team join and 30 for membership. Always a multiple of 5.
    function validPoints(p) {
      return p is int && p >= 5 && p <= 80 && p % 5 == 0;
    }

    function validFollowUp(d) {
      return d.keys().hasAll(['guestId', 'worker', 'loggedBy', 'callDate', 'month',
          'outcome', 'points', 'createdAt'])
        && d.keys().hasOnly(['guestId', 'worker', 'loggedBy', 'callDate', 'month',
          'outcome', 'note', 'attendedSunday', 'sundayDate', 'attendedWednesday',
          'wednesdayDate', 'team', 'points', 'syncedToSheet', 'createdAt'])
        && d.guestId is string
        && d.outcome in ['Reached', 'No answer', 'Busy', 'Switched off',
          'Wrong number', 'Not interested']
        && (!('note' in d) || (d.note is string && d.note.size() <= 2000))
        && (!('team' in d) || d.team in ['', 'Workforce', 'Evangelism'])
        && (!('syncedToSheet' in d) || d.syncedToSheet == false)
        && validPoints(d.points)
        && d.worker == get(guestPath(d.guestId)).data.assignedTo
        && d.loggedBy == myEmail();
    }

    match /users/{email} {
      allow read: if isMember() && (email == myEmail() || isAdmin());
      allow write: if false;
    }

    match /meta/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /guests/{guestId} {
      allow read: if canSeeGuest(resource.data);
      allow create, delete: if false;
      allow update: if canSeeGuest(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(workFields());
    }

    match /followUps/{followUpId} {
      // Workers see follow-ups credited to them (including ones an admin logged).
      allow read: if isAdmin() || (isWorker() && resource.data.worker == myEmail());
      // Workers log for their own guests; admins log on behalf of the assigned worker.
      allow create: if validFollowUp(request.resource.data)
        && (isAdmin() || (isWorker() && request.resource.data.worker == myEmail()));
      allow update, delete: if false;
    }
  }
}
