rules_version = '2';

// PCU Connect security rules (docs/BACKEND_PLAN.md).
//
// Every request needs a verified Google sign-in whose email has an active
// users/{email} document. Emails are trimmed and lowercased before every
// lookup or comparison. users and meta are written only by Apps Script
// (service account, which bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.trim().lower();
    }

    function userPath(email) {
      return /databases/$(database)/documents/users/$(email);
    }

    function isMember() {
      return signedIn()
        && exists(userPath(myEmail()))
        && get(userPath(myEmail())).data.active == true;
    }

    function role() {
      return get(userPath(myEmail())).data.role;
    }

    function isAdmin() {
      return isMember() && role() == 'admin';
    }

    function isWorker() {
      return isMember() && role() == 'worker';
    }

    function guestPath(guestId) {
      return /databases/$(database)/documents/guests/$(guestId);
    }

    // Fields Firebase owns on a guest. Everything else (name, phone,
    // serviceDate, month, assignedTo, assignedName, assignedDate, sheetRow)
    // belongs to the sheet and is only ever written by Apps Script.
    function workFields() {
      return ['callStatus', 'membershipStatus', 'followUpCount', 'firstCallAt',
        'lastFeedback', 'lastFeedbackDate', 'teamJoined', 'memberSince',
        'sundayDates', 'wednesdayDates', 'updatedAt', 'lastFollowUpId'];
    }

    function outcomes() {
      return ['Reached', 'No answer', 'Busy', 'Switched off', 'Wrong number', 'Not interested'];
    }

    function teams() {
      return ['', 'Workforce', 'Evangelism'];
    }

    function statuses() {
      return ['New guest', 'Contacted', 'Returning', 'Member', 'Not interested', 'Unreachable'];
    }

    // Days as yyyymmdd numbers, so 'yyyy-MM-dd' strings compare with today.
    function isDay(s) {
      return s is string && s.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function dayNumber(s) {
      return int(s[0:4]) * 10000 + int(s[5:7]) * 100 + int(s[8:10]);
    }

    // Today in Africa/Lagos (UTC+1 all year), from the server clock.
    function lagosToday() {
      let t = request.time + duration.value(1, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    function pastDay(s) {
      return isDay(s) && dayNumber(s) <= lagosToday();
    }

    // An attendance flag with its date: a past day when set, empty otherwise.
    function validAttendance(d, flag, date) {
      return !(flag in d) || d[flag] == false
        ? (!(date in d) || d[date] == '')
        : (d[flag] == true && date in d && pastDay(d[date]));
    }

    function canSeeGuest(data) {
      return isAdmin() || (isWorker() && data.assignedTo == myEmail());
    }

    // Points for one follow-up: base 5 or 10, plus 10 per attendance (up to
    // 2), 20 for a team join and 30 for membership. Always a multiple of 5.
    function validPoints(p) {
      return p is int && p >= 5 && p <= 80 && p % 5 == 0;
    }

    function validFollowUp(d) {
      return d.keys().hasAll(['guestId', 'worker', 'loggedBy', 'callDate', 'month',
          'outcome', 'points', 'createdAt'])
        && d.keys().hasOnly(['guestId', 'worker', 'loggedBy', 'callDate', 'month',
          'outcome', 'note', 'attendedSunday', 'sundayDate', 'attendedWednesday',
          'wednesdayDate', 'team', 'points', 'syncedToSheet', 'createdAt'])
        && d.guestId is string
        && d.outcome in outcomes()
        && (!('note' in d) || (d.note is string && d.note.size() <= 2000))
        && (!('team' in d) || d.team in teams())
        && (!('syncedToSheet' in d) || d.syncedToSheet == false)
        && validPoints(d.points)
        && pastDay(d.callDate)
        && d.month == d.callDate[0:7]
        && validAttendance(d, 'attendedSunday', 'sundayDate')
        && validAttendance(d, 'attendedWednesday', 'wednesdayDate')
        && d.createdAt == request.time
        && d.worker is string && d.worker.size() > 0
        && d.worker == get(guestPath(d.guestId)).data.assignedTo
        && d.loggedBy == myEmail();
    }

    // A guest's work fields change only together with a new follow-up for
    // that guest in the same batch, and every value has the right shape.
    function validWorkUpdate(guestId) {
      let after = request.resource.data;
      let changed = after.diff(resource.data).affectedKeys();
      return changed.hasOnly(workFields())
        && changed.hasAll(['followUpCount', 'lastFollowUpId', 'updatedAt'])
        && after.followUpCount == resource.data.get('followUpCount', 0) + 1
        && after.updatedAt == request.time
        && after.lastFollowUpId is string
        && existsAfter(/databases/$(database)/documents/followUps/$(after.lastFollowUpId))
        && !exists(/databases/$(database)/documents/followUps/$(after.lastFollowUpId))
        && getAfter(/databases/$(database)/documents/followUps/$(after.lastFollowUpId)).data.guestId == guestId
        && (!('callStatus' in changed) || after.callStatus in outcomes())
        && (!('membershipStatus' in changed) || after.membershipStatus in statuses())
        && (!('teamJoined' in changed) || after.teamJoined in teams())
        && (!('lastFeedback' in changed) || (after.lastFeedback is string && after.lastFeedback.size() <= 2000))
        && (!('sundayDates' in changed) || after.sundayDates is list)
        && (!('wednesdayDates' in changed) || after.wednesdayDates is list);
    }

    match /users/{email} {
      allow read: if isMember() && (email == myEmail() || isAdmin());
      allow write: if false;
    }

    match /meta/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /guests/{guestId} {
      allow read: if canSeeGuest(resource.data);
      allow create, delete: if false;
      allow update: if canSeeGuest(resource.data) && validWorkUpdate(guestId);
    }

    match /followUps/{followUpId} {
      // Workers see follow-ups credited to them (including ones an admin logged).
      allow read: if isAdmin() || (isWorker() && resource.data.worker == myEmail());
      // Workers log for their own guests; admins log on behalf of the assigned worker.
      allow create: if validFollowUp(request.resource.data)
        && (isAdmin() || (isWorker() && request.resource.data.worker == myEmail()));
      allow update, delete: if false;
    }
  }
}
